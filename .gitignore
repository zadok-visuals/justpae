# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets. .env.local.example is committed on purpose.
.env
.env*.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase CLI local state
/supabase/.branches
/supabase/.temp
/supabase/.env

# Agent worktrees live under .claude/ in a working checkout. .claude/launch.json
# IS committed — it is how `npm run dev` gets started for a preview — so the
# directory cannot be ignored wholesale; this ignores the one thing in it that
# is a scratch checkout of this same repo.
/.claude/worktrees
