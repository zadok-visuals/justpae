default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight"
  lane :deploy do
    # Authenticate with App Store Connect
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_P8"],
      duration: 1200,
      in_house: false
    )
    
    # App creation via Fastlane produce is unsupported with API keys.
    # Please create the App ID and App manually in the Apple Developer Portal and App Store Connect.
    
    # 0.5 Revoke old distribution certificates to avoid hitting the 3-cert limit on fresh CI runners
    begin
      require 'spaceship'
      # Create a proper Spaceship API Token object (api_key is just a Hash)
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV["APPSTORE_KEY_ID"],
        issuer_id: ENV["APPSTORE_ISSUER_ID"],
        key: ENV["APPSTORE_P8"]
      )
      
      certs = Spaceship::ConnectAPI::Certificate.all
      certs.each do |c|
        if c.certificate_type.to_s.include?("DISTRIBUTION")
          UI.important("Revoking old distribution certificate (#{c.certificate_type}) to free up space: #{c.id}")
          Spaceship::ConnectAPI.client.delete_certificate(certificate_id: c.id)
        end
      end
    rescue => e
      UI.error("Notice: Could not revoke old certificates: #{e.message}")
    end
    
    # 1. Fetch valid certificates from Apple Portal
    get_certificates(api_key: api_key)
    
    # 2. Fetch valid provisioning profiles from Apple Portal
    get_provisioning_profile(api_key: api_key)
    
    # 3. Compile the application
    build_app(
      scheme: "App",
      workspace: "App.xcworkspace",
      include_bitcode: false
    )
    
    # 4. Upload build to TestFlight
    upload_to_testflight(api_key: api_key)
  end
end
