# ============================================================================
# justpae — environment variables
#
# Copy to .env.local for local development, and set the same values in the
# hosting provider's project settings for deployment. .env.local is gitignored;
# NEVER commit real values.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# therefore PUBLIC. Only the Supabase URL, the anon key (which is designed to
# be public and is governed entirely by RLS) and the feature flags carry that
# prefix. Every credential below is server-only.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key: dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. BYPASSES RLS COMPLETELY. Used only by the webhook
# receivers, the cron reconcilers, the automated-payout path and the
# admin-gated server actions. If this ever appears in a client bundle, every
# user's data is readable by anyone — it has no NEXT_PUBLIC_ prefix for that
# reason and must never be given one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google sign-in, for `supabase start` locally. In a deployed project these are
# set in the dashboard under Authentication → Providers → Google instead.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
# The deployed origin, no trailing slash. Used to build auth email links, the
# OAuth redirect and the /receive share link. A wrong value here produces
# confirmation emails whose links point at the wrong host — set it per
# environment, including preview deployments.
APP_URL=http://localhost:3000

# Comma-separated email allowlist for /admin. Admin is NOT a database role:
# this list is the entire gate, checked by src/lib/auth/admin.ts in front of
# every admin page and every admin server action.
ADMIN_EMAILS=you@example.com

# ── Cron ────────────────────────────────────────────────────────────────────
# Shared secret for the reconciliation routes, sent as
# `Authorization: Bearer <value>`.
#
# REQUIRED. The gate FAILS CLOSED: with this unset every cron route returns 503
# rather than running. Those routes credit deposits and complete payouts, so an
# unset secret must not leave them publicly callable.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Busha (primary provider: NGN/KES/USDT deposits, conversions, payouts) ───
# Secret key from the Busha Business dashboard.
#
# Note: a real registered Business account's key was rejected outright by the
# documented sandbox host and worked immediately against production. Do not
# assume a sandbox exists for your account before testing it.
BUSHA_API_KEY=
BUSHA_API_BASE_URL=https://api.busha.io

# Webhook signing secret. The receiver expects `x-bu-signature` carrying
# base64(HMAC-SHA256(secret, rawBody)).
BUSHA_WEBHOOK_SECRET=

# Reject deliveries whose signature doesn't match, instead of logging and
# continuing. Left OFF by default on purpose: the header name and scheme were
# established by reverse-engineering real deliveries rather than from published
# documentation, and a wrong guess here rejects every genuine webhook with a
# 401 before it is even recorded — which is exactly what happened on the
# predecessor of this code and left months of deposits uncredited. Turn it on
# once real traffic has passed with no logged mismatch.
#
# Safe to leave off: the receiver never acts on the payload's own claims. It
# re-fetches the transfer from the provider's API and acts only on that.
BUSHA_WEBHOOK_REJECT_INVALID_SIGNATURE=false

# ── Klasha (GHS deposit collection only) ────────────────────────────────────
# Behind NEXT_PUBLIC_FEATURE_KLASHA_GHS_DEPOSIT, which ships off. Every live
# call so far has returned an account-wide 403, including a bodyless GET, so
# the account itself is not cleared. Leave these blank until it is.
KLASHA_LOGIN_EMAIL=
KLASHA_LOGIN_PASSWORD=
KLASHA_PUBLIC_KEY=
# Documented as a 3DES key, but the real secret base64-decodes to 32 bytes — a
# valid AES-256 length and an invalid 3DES one. Try AES-256-CBC first once
# account access clears.
KLASHA_ENCRYPTION_SECRET=
KLASHA_WEBHOOK_SECRET=
KLASHA_API_BASE_URL=https://dev.kcookery.com

# ── USD collection (Feature 1, /receive) ────────────────────────────────────
# No provider is confirmed yet, so there is no credential to set. When one is
# chosen, add its variables here and implement the interface in
# src/lib/providers/usdCollection.ts.
# USD_COLLECTION_API_KEY=

# ── Bills provider (Feature 5) ──────────────────────────────────────────────
# No provider is chosen yet. See the header of src/lib/providers/bills.ts for
# the realistic options covering Nigeria, Ghana and Kenya.
# BILLS_API_KEY=
# BILLS_API_SECRET=

# ── Feature flags ───────────────────────────────────────────────────────────
# All default OFF. Each gates a path whose provider is not yet confirmed for
# this account. The rule: when a provider is unconfirmed, the UI, schema and
# server action are all built, the provider call sits behind an interface, and
# the flag ships off with an honest "coming soon" state. Flipping the flag is
# then the only change needed once credentials land.
#
# NEXT_PUBLIC_ because a Client Component renders the right state without a
# round trip. These say "is this feature on", never "here is a secret".

# Feature 1 — USD receiving details on /receive.
# Waiting on: which provider will issue USD collection on this account.
NEXT_PUBLIC_FEATURE_USD_COLLECTION=false

# Feature 2 — GHS deposits via Klasha.
# Waiting on: account access (every live call returns a 403), the real
# request-body encryption scheme, and the webhook signature scheme.
NEXT_PUBLIC_FEATURE_KLASHA_GHS_DEPOSIT=false

# Feature 5 — bills and airtime.
# Waiting on: provider selection.
NEXT_PUBLIC_FEATURE_BILLS=false
