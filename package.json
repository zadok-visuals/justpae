{
  "name": "justpae-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\"",
    "emails:build": "node --experimental-strip-types scripts/build-emails.ts",
    "e2e": "playwright test",
    "e2e:public": "playwright test --project=public",
    "e2e:authed": "E2E_REQUIRE_AUTHED=1 playwright test --project=authed",
    "e2e:responsive": "playwright test --project=mobile-375 --project=tablet-768 --project=desktop-1024 --project=desktop-1280 --project=desktop-1440 --project=desktop-1920",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "next": "16.2.10",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0",
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fontkit": "^2.0.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
